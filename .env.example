RATE_LIMIT_ORDER_MAX=20
RATE_LIMIT_REVIEW_MAX=20
RATE_LIMIT_QUESTION_MAX=20
OTP_EXPIRES_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
SMTP_USER=
SMTP_APP_PASSWORD=
