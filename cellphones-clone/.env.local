# Keep this empty in production so the built frontend uses the same origin as Node.
VITE_API_BASE_URL=http://localhost:5050
VITE_API_REQUEST_TIMEOUT_MS=15000
VITE_API_GET_CACHE_MAX_ENTRIES=300
VITE_GOOGLE_CLIENT_ID=
# Optional: enables the interactive Google Maps 3D view. The page uses an iframe fallback without it.
VITE_GOOGLE_MAPS_API_KEY=
